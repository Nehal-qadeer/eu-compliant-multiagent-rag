# Enterprise-Grade EU-Compliant Multi-Agent RAG Configuration

# Security & Compliance
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-secure-32-byte-hex-key-in-production
GDPR_CRYPTO_KEY_VAULT_TYPE=in_memory  # in_memory, hashicorp_vault, azure_key_vault
AUDIT_LOG_STORAGE_PATH=./logs/audit.jsonl

# EU Sovereign Inference Endpoints
SOVEREIGN_LLM_PROVIDER=local_vllm     # local_vllm, ollama, mistral_eu, azure_eu
SOVEREIGN_LLM_BASE_URL=http://localhost:8000/v1
SOVEREIGN_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
SOVEREIGN_EMBEDDING_MODEL=BAAI/bge-m3

# Vector Database (EU Sovereign Region)
VECTOR_DB_TYPE=qdrant                  # qdrant, pgvector, in_memory
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_DB_COLLECTION=enterprise_documents

# PII Sanitization
PII_DETECTION_CONFIDENCE_THRESHOLD=0.60
PII_MASKING_STRATEGY=pseudonymize       # pseudonymize, redact, synthetic
