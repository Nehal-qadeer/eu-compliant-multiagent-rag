# Enterprise EU Sovereign Multi-Agent RAG Configuration (.env)

# Environment & General
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security, CORS & Role-Based Access Control (RBAC)
REQUIRE_AUTH=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","https://nehal-portfolio-one.vercel.app"]
API_KEY_ADMIN=admin-root-key-1122
API_KEY_DPO=dpo-secure-key-9988
API_KEY_EMPLOYEE=employee-user-key-3344
API_KEY_AUDITOR=auditor-inspect-key-5566

# Cryptographic Key Vault & Master Key (GDPR Article 17 / Article 32)
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
VAULT_BACKEND=in_memory  # in_memory, file, azure_key_vault
AUDIT_LOG_FILE=./logs/audit_ledger.jsonl

# LLM Inference Providers (EU Sovereign or Cloud)
SOVEREIGN_LLM_PROVIDER=local_vllm  # local_vllm, ollama, mistral_eu, azure_eu, anthropic_claude, mock
SOVEREIGN_LLM_BASE_URL=http://localhost:8000/v1
OLLAMA_BASE_URL=http://localhost:11434
SOVEREIGN_LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3
SOVEREIGN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional Cloud LLM (Note: sets is_sovereign=False in response metadata)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Vector Storage
VECTOR_DB_TYPE=in_memory  # in_memory, qdrant, pgvector
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_DB_COLLECTION=enterprise_knowledge_base

# PII & Privacy Guardrails (Presidio & Custom EU Recognizers)
PII_DETECTION_CONFIDENCE=0.60
PII_MASKING_STRATEGY=pseudonymize  # pseudonymize, redact, mask

# RAG Chunking Parameters
DEFAULT_CHUNK_SIZE=512
DEFAULT_CHUNK_OVERLAP=64

